{%- comment -%}
  LunTea custom product page (direct-response layout).
  Hero gallery + purchase box (one-time / subscribe), benefits, research, ritual,
  ingredients, app blocks (reviews), FAQ, final CTA, mobile sticky add-to-cart.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'lt-form-' | append: section.id
  assign sp_group = product.selling_plan_groups.first
  assign sp = sp_group.selling_plans.first
  assign sub_price = blank
  if sp
    for alloc in current_variant.selling_plan_allocations
      if alloc.selling_plan.id == sp.id
        assign sub_price = alloc.price
      endif
    endfor
  endif
  assign bags = section.settings.bags_per_pouch | default: 60
  assign per_cup = current_variant.price | divided_by: bags
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  #lt-{{ section.id }} {
    --lt-red: #8e1b2b;
    --lt-red-dark: #6d1220;
    --lt-ink: #2a1416;
    --lt-muted: #6f5a5c;
    --lt-cream: #fbf5ef;
    --lt-blush: #f6e3e1;
    --lt-line: #ead7d3;
    --lt-green: #2f6b4f;
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--lt-ink);
    background: var(--lt-cream);
    line-height: 1.55;
  }
  #lt-{{ section.id }} * { box-sizing: border-box; }
  #lt-{{ section.id }} h1, #lt-{{ section.id }} h2, #lt-{{ section.id }} h3 {
    font-family: 'Fraunces', Georgia, serif; font-weight: 600; color: var(--lt-ink); margin: 0; letter-spacing: -0.01em;
  }
  .lt-wrap { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .lt-section { padding: 72px 0; }
  .lt-section--blush { background: var(--lt-blush); }
  .lt-section--red { background: var(--lt-red); color: #fff; }
  .lt-section--red h2 { color: #fff; }
  .lt-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lt-red); margin: 0 0 12px; }
  .lt-section--red .lt-eyebrow { color: #f7c9cf; }
  .lt-h2 { font-size: clamp(28px, 4vw, 42px); line-height: 1.15; margin-bottom: 16px !important; }
  .lt-lead { font-size: 18px; color: var(--lt-muted); max-width: 640px; margin: 0; }
  .lt-center { text-align: center; }
  .lt-center .lt-lead { margin: 0 auto; }

  /* Hero */
  .lt-hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; padding: 40px 0 72px; align-items: start; }
  .lt-gallery__main { background: #fff; border-radius: 20px; overflow: hidden; aspect-ratio: 1/1; display: flex; align-items: center; justify-content: center; }
  .lt-gallery__main img { width: 100%; height: 100%; object-fit: contain; }
  .lt-gallery__thumbs { display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; }
  .lt-gallery__thumbs button { flex: 0 0 72px; height: 72px; border-radius: 12px; overflow: hidden; border: 2px solid transparent; background: #fff; padding: 0; cursor: pointer; }
  .lt-gallery__thumbs button[aria-current="true"] { border-color: var(--lt-red); }
  .lt-gallery__thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .lt-placeholder { width: 70%; opacity: .25; }

  .lt-rating { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--lt-muted); margin-bottom: 10px; }
  .lt-stars { color: #e0a526; letter-spacing: 2px; }
  .lt-title { font-size: clamp(34px, 5vw, 52px); line-height: 1.05; margin-bottom: 12px !important; }
  .lt-sub { font-size: 18px; color: var(--lt-muted); margin: 0 0 20px; }
  .lt-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
  .lt-pill { font-size: 13px; font-weight: 500; padding: 6px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--lt-line); }
  .lt-checks { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 10px; }
  .lt-checks li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; }
  .lt-checks svg { flex: 0 0 20px; margin-top: 3px; color: var(--lt-green); }

  /* Purchase box */
  .lt-buy { display: grid; gap: 12px; }
  .lt-option { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border: 2px solid var(--lt-line); border-radius: 14px; background: #fff; cursor: pointer; transition: border-color .15s; position: relative; }
  .lt-option input { accent-color: var(--lt-red); width: 18px; height: 18px; margin: 0; }
  .lt-option.is-active { border-color: var(--lt-red); background: #fff9f8; }
  .lt-option__body { flex: 1; }
  .lt-option__name { font-weight: 600; font-size: 16px; display: block; }
  .lt-option__note { font-size: 13px; color: var(--lt-muted); display: block; }
  .lt-option__price { text-align: right; font-weight: 600; font-size: 18px; }
  .lt-option__price s { display: block; font-weight: 400; font-size: 13px; color: var(--lt-muted); }
  .lt-badge { position: absolute; top: -11px; right: 16px; background: var(--lt-red); color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; }
  .lt-row { display: flex; gap: 12px; margin-top: 4px; }
  .lt-qty { display: flex; align-items: center; border: 2px solid var(--lt-line); border-radius: 14px; background: #fff; }
  .lt-qty button { width: 44px; height: 54px; background: none; border: 0; font-size: 20px; cursor: pointer; color: var(--lt-ink); }
  .lt-qty input { width: 36px; text-align: center; border: 0; font-size: 16px; font-weight: 600; background: none; -moz-appearance: textfield; }
  .lt-qty input::-webkit-outer-spin-button, .lt-qty input::-webkit-inner-spin-button { -webkit-appearance: none; }
  .lt-btn { flex: 1; display: inline-flex; align-items: center; justify-content: center; min-height: 58px; padding: 0 28px; border: 0; border-radius: 14px; background: var(--lt-red); color: #fff; font-family: inherit; font-size: 17px; font-weight: 600; cursor: pointer; text-decoration: none; transition: background .15s; }
  .lt-btn:hover { background: var(--lt-red-dark); }
  .lt-btn[disabled] { opacity: .5; cursor: not-allowed; }
  .lt-btn--light { background: #fff; color: var(--lt-red); flex: 0 0 auto; }
  .lt-btn--light:hover { background: var(--lt-blush); }
  .lt-trust { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; font-size: 13px; color: var(--lt-muted); text-align: center; }
  .lt-trust span { display: block; font-size: 20px; margin-bottom: 2px; }
  .lt-percup { font-size: 13px; color: var(--lt-muted); margin: 2px 0 0; text-align: center; }

  /* Benefits */
  .lt-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  .lt-card { background: #fff; border-radius: 18px; padding: 26px 22px; border: 1px solid var(--lt-line); }
  .lt-card__icon { font-size: 28px; margin-bottom: 12px; }
  .lt-card h3 { font-size: 20px; margin-bottom: 8px !important; }
  .lt-card p { margin: 0; color: var(--lt-muted); font-size: 15px; }

  /* Split */
  .lt-split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .lt-split__img { border-radius: 20px; overflow: hidden; background: #fff; aspect-ratio: 4/5; }
  .lt-split__img img { width: 100%; height: 100%; object-fit: cover; }
  .lt-stat { display: flex; gap: 18px; align-items: baseline; margin: 24px 0; padding: 22px; border-radius: 16px; background: rgba(255,255,255,.1); }
  .lt-stat strong { font-family: 'Fraunces', Georgia, serif; font-size: 48px; line-height: 1; }
  .lt-source { font-size: 13px; opacity: .8; margin-top: 12px; }
  .lt-steps { list-style: none; counter-reset: s; padding: 0; margin: 24px 0 0; display: grid; gap: 16px; }
  .lt-steps li { counter-increment: s; display: flex; gap: 16px; align-items: flex-start; }
  .lt-steps li::before { content: counter(s); flex: 0 0 36px; height: 36px; border-radius: 50%; background: var(--lt-red); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 600; }
  .lt-steps strong { display: block; }
  .lt-steps span { color: var(--lt-muted); font-size: 15px; }

  /* Ingredients */
  .lt-ingredient { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  .lt-ingredient div { text-align: center; padding: 24px; background: #fff; border-radius: 18px; border: 1px solid var(--lt-line); }
  .lt-ingredient strong { display: block; font-family: 'Fraunces', Georgia, serif; font-size: 22px; margin-bottom: 4px; }
  .lt-ingredient span { color: var(--lt-muted); font-size: 14px; }

  /* FAQ */
  .lt-faq { max-width: 760px; margin: 36px auto 0; }
  .lt-faq details { border-bottom: 1px solid var(--lt-line); padding: 18px 0; }
  .lt-faq summary { cursor: pointer; font-weight: 600; font-size: 17px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .lt-faq summary::-webkit-details-marker { display: none; }
  .lt-faq summary::after { content: '+'; font-size: 22px; color: var(--lt-red); line-height: 1; }
  .lt-faq details[open] summary::after { content: '–'; }
  .lt-faq .lt-faq__a { color: var(--lt-muted); padding-top: 10px; }
  .lt-faq .lt-faq__a p { margin: 0 0 8px; }

  .lt-final { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .lt-disclaimer { font-size: 12px; color: var(--lt-muted); text-align: center; max-width: 760px; margin: 0 auto; padding: 28px 20px 40px; }

  /* Sticky ATC */
  .lt-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: #fff; border-top: 1px solid var(--lt-line); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 12px; transform: translateY(110%); transition: transform .25s; box-shadow: 0 -6px 20px rgba(0,0,0,.06); }
  .lt-sticky.is-visible { transform: translateY(0); }
  .lt-sticky__info { flex: 1; min-width: 0; }
  .lt-sticky__info strong { display: block; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lt-sticky__info span { font-size: 14px; color: var(--lt-muted); }
  .lt-sticky .lt-btn { flex: 0 0 auto; min-height: 48px; font-size: 15px; padding: 0 22px; }

  @media (max-width: 989px) {
    .lt-hero { grid-template-columns: 1fr; gap: 28px; padding-top: 16px; }
    .lt-grid { grid-template-columns: repeat(2, 1fr); }
    .lt-split { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 600px) {
    .lt-section { padding: 52px 0; }
    .lt-grid, .lt-ingredient { grid-template-columns: 1fr; }
    .lt-row { flex-wrap: wrap; }
    .lt-qty { flex: 0 0 auto; }
  }
  @media (min-width: 990px) { .lt-sticky { display: none; } }
</style>

<div id="lt-{{ section.id }}" class="lt-page">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <div class="lt-wrap">
    <div class="lt-hero">
      <div class="lt-gallery" data-lt-gallery>
        <div class="lt-gallery__main">
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: product.featured_media.alt, data-lt-main: '' }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'lt-placeholder' }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="lt-gallery__thumbs">
            {%- for media in product.media -%}
              {%- if media.media_type == 'image' -%}
                <button type="button" aria-label="Show image {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %} data-src="{{ media | image_url: width: 1200 }}" data-alt="{{ media.alt | escape }}">
                  {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="lt-info">
        {%- if section.settings.rating_text != blank -%}
          <div class="lt-rating"><span class="lt-stars">★★★★★</span> {{ section.settings.rating_text }}</div>
        {%- endif -%}
        <p class="lt-eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 class="lt-title">{{ product.title }}</h1>
        <p class="lt-sub">{{ section.settings.subheadline }}</p>

        <div class="lt-pills">
          {%- for i in (1..4) -%}
            {%- assign key = 'pill_' | append: i -%}
            {%- if section.settings[key] != blank -%}<span class="lt-pill">{{ section.settings[key] }}</span>{%- endif -%}
          {%- endfor -%}
        </div>

        <ul class="lt-checks">
          {%- for i in (1..4) -%}
            {%- assign key = 'check_' | append: i -%}
            {%- if section.settings[key] != blank -%}
              <li><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"/></svg><span>{{ section.settings[key] }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        {%- form 'product', product, id: form_id, class: 'lt-buy', novalidate: 'novalidate', data-lt-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- if sp and sub_price -%}
            {%- assign save_pct = current_variant.price | minus: sub_price | times: 100 | divided_by: current_variant.price -%}
            <label class="lt-option is-active" data-lt-option="subscribe" data-price="{{ sub_price | money }}">
              <span class="lt-badge">Save {{ save_pct }}%</span>
              <input type="radio" name="lt-purchase" value="subscribe" checked>
              <span class="lt-option__body">
                <span class="lt-option__name">Subscribe &amp; Save</span>
                <span class="lt-option__note">{{ sp.name }} · Skip or cancel anytime</span>
              </span>
              <span class="lt-option__price"><s>{{ current_variant.price | money }}</s>{{ sub_price | money }}</span>
            </label>
            <label class="lt-option" data-lt-option="onetime" data-price="{{ current_variant.price | money }}">
              <input type="radio" name="lt-purchase" value="onetime">
              <span class="lt-option__body">
                <span class="lt-option__name">One-time purchase</span>
                <span class="lt-option__note">{{ bags }} pyramid tea bags</span>
              </span>
              <span class="lt-option__price">{{ current_variant.price | money }}</span>
            </label>
            <input type="hidden" name="selling_plan" value="{{ sp.id }}" data-lt-plan>
          {%- else -%}
            <div class="lt-option is-active">
              <span class="lt-option__body">
                <span class="lt-option__name">{{ bags }} pyramid tea bags</span>
                <span class="lt-option__note">One pouch · about 2 months of daily cups</span>
              </span>
              <span class="lt-option__price">
                {%- if current_variant.compare_at_price > current_variant.price -%}<s>{{ current_variant.compare_at_price | money }}</s>{%- endif -%}
                {{ current_variant.price | money }}
              </span>
            </div>
          {%- endif -%}

          <div class="lt-row">
            <div class="lt-qty">
              <button type="button" aria-label="Decrease quantity" data-lt-qty="-1">−</button>
              <input type="number" name="quantity" value="1" min="1" max="10" aria-label="Quantity" data-lt-qty-input>
              <button type="button" aria-label="Increase quantity" data-lt-qty="1">+</button>
            </div>
            <button type="submit" name="add" class="lt-btn" {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}Add to cart · <span data-lt-btn-price>&nbsp;{% if sp and sub_price %}{{ sub_price | money }}{% else %}{{ current_variant.price | money }}{% endif %}</span>{%- else -%}Sold out{%- endif -%}
            </button>
          </div>
          <p class="lt-percup">That's about {{ per_cup | money }} a cup</p>
        {%- endform -%}

        <div class="lt-trust">
          <div><span>🚚</span>{{ section.settings.trust_1 }}</div>
          <div><span>🛡️</span>{{ section.settings.trust_2 }}</div>
          <div><span>🌿</span>{{ section.settings.trust_3 }}</div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ===== BENEFITS ===== {%- endcomment -%}
  <section class="lt-section lt-section--blush">
    <div class="lt-wrap lt-center">
      <p class="lt-eyebrow">{{ section.settings.benefits_eyebrow }}</p>
      <h2 class="lt-h2">{{ section.settings.benefits_heading }}</h2>
      <p class="lt-lead">{{ section.settings.benefits_text }}</p>
      <div class="lt-grid" style="text-align:left">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="lt-card" {{ block.shopify_attributes }}>
              <div class="lt-card__icon">{{ block.settings.icon }}</div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== RESEARCH ===== {%- endcomment -%}
  {%- if section.settings.show_research -%}
  <section class="lt-section lt-section--red">
    <div class="lt-wrap lt-split">
      <div>
        <p class="lt-eyebrow">{{ section.settings.research_eyebrow }}</p>
        <h2 class="lt-h2">{{ section.settings.research_heading }}</h2>
        <div>{{ section.settings.research_text }}</div>
        <div class="lt-stat">
          <strong>{{ section.settings.research_stat }}</strong>
          <span>{{ section.settings.research_stat_label }}</span>
        </div>
        <p class="lt-source">{{ section.settings.research_source }}</p>
      </div>
      <div class="lt-split__img">
        {%- if section.settings.research_image -%}
          {{ section.settings.research_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'lt-placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ===== RITUAL / HOW TO BREW ===== {%- endcomment -%}
  <section class="lt-section">
    <div class="lt-wrap lt-split">
      <div class="lt-split__img">
        {%- if section.settings.ritual_image -%}
          {{ section.settings.ritual_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'lt-placeholder' }}
        {%- endif -%}
      </div>
      <div>
        <p class="lt-eyebrow">{{ section.settings.ritual_eyebrow }}</p>
        <h2 class="lt-h2">{{ section.settings.ritual_heading }}</h2>
        <p class="lt-lead">{{ section.settings.ritual_text }}</p>
        <ol class="lt-steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li {{ block.shopify_attributes }}><div><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></div></li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ===== INGREDIENTS ===== {%- endcomment -%}
  <section class="lt-section lt-section--blush">
    <div class="lt-wrap lt-center">
      <p class="lt-eyebrow">{{ section.settings.ingredients_eyebrow }}</p>
      <h2 class="lt-h2">{{ section.settings.ingredients_heading }}</h2>
      <p class="lt-lead">{{ section.settings.ingredients_text }}</p>
      <div class="lt-ingredient">
        <div><strong>{{ section.settings.fact_1_title }}</strong><span>{{ section.settings.fact_1_text }}</span></div>
        <div><strong>{{ section.settings.fact_2_title }}</strong><span>{{ section.settings.fact_2_text }}</span></div>
        <div><strong>{{ section.settings.fact_3_title }}</strong><span>{{ section.settings.fact_3_text }}</span></div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== APP BLOCKS (reviews etc.) ===== {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <section class="lt-section"><div class="lt-wrap">{% render block %}</div></section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ===== FAQ ===== {%- endcomment -%}
  <section class="lt-section">
    <div class="lt-wrap">
      <div class="lt-center">
        <p class="lt-eyebrow">FAQ</p>
        <h2 class="lt-h2">{{ section.settings.faq_heading }}</h2>
      </div>
      <div class="lt-faq">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="lt-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== FINAL CTA ===== {%- endcomment -%}
  <section class="lt-section lt-section--red">
    <div class="lt-wrap lt-center lt-final">
      <h2 class="lt-h2">{{ section.settings.final_heading }}</h2>
      <p class="lt-lead" style="color:#f7dfe2">{{ section.settings.final_text }}</p>
      <button type="button" class="lt-btn lt-btn--light" data-lt-scroll>{{ section.settings.final_button }}</button>
    </div>
  </section>

  {%- if section.settings.disclaimer != blank -%}
    <p class="lt-disclaimer">{{ section.settings.disclaimer }}</p>
  {%- endif -%}

  {%- comment -%} ===== MOBILE STICKY ATC ===== {%- endcomment -%}
  <div class="lt-sticky" data-lt-sticky aria-hidden="true">
    <div class="lt-sticky__info">
      <strong>{{ product.title }}</strong>
      <span data-lt-sticky-price>{% if sp and sub_price %}{{ sub_price | money }} with subscription{% else %}{{ current_variant.price | money }}{% endif %}</span>
    </div>
    <button type="button" class="lt-btn" data-lt-sticky-btn {% unless current_variant.available %}disabled{% endunless %}>Add to cart</button>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('lt-{{ section.id }}');
    if (!root) return;
    var form = root.querySelector('[data-lt-form]');

    // Gallery
    var main = root.querySelector('[data-lt-main]');
    root.querySelectorAll('.lt-gallery__thumbs button').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (main) { main.src = btn.dataset.src; main.removeAttribute('srcset'); main.alt = btn.dataset.alt || ''; }
        root.querySelectorAll('.lt-gallery__thumbs button').forEach(function (b) { b.removeAttribute('aria-current'); });
        btn.setAttribute('aria-current', 'true');
      });
    });

    // Purchase options
    var plan = root.querySelector('[data-lt-plan]');
    var btnPrice = root.querySelector('[data-lt-btn-price]');
    var stickyPrice = root.querySelector('[data-lt-sticky-price]');
    root.querySelectorAll('[data-lt-option]').forEach(function (opt) {
      opt.querySelector('input').addEventListener('change', function () {
        root.querySelectorAll('[data-lt-option]').forEach(function (o) { o.classList.remove('is-active'); });
        opt.classList.add('is-active');
        var sub = opt.dataset.ltOption === 'subscribe';
        if (plan) plan.disabled = !sub;
        if (btnPrice) btnPrice.innerHTML = '&nbsp;' + opt.dataset.price;
        if (stickyPrice) stickyPrice.textContent = opt.dataset.price + (sub ? ' with subscription' : '');
      });
    });

    // Quantity
    var qty = root.querySelector('[data-lt-qty-input]');
    root.querySelectorAll('[data-lt-qty]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = parseInt(qty.value, 10) || 1;
        qty.value = Math.min(10, Math.max(1, v + parseInt(b.dataset.ltQty, 10)));
      });
    });

    // Scroll-to-buy + sticky bar
    var buy = form;
    root.querySelectorAll('[data-lt-scroll]').forEach(function (b) {
      b.addEventListener('click', function () { buy.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
    });
    var sticky = root.querySelector('[data-lt-sticky]');
    var stickyBtn = root.querySelector('[data-lt-sticky-btn]');
    if (stickyBtn) stickyBtn.addEventListener('click', function () { form.requestSubmit ? form.requestSubmit() : form.submit(); });
    if (sticky && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var past = !entries[0].isIntersecting && entries[0].boundingClientRect.top < 0;
        sticky.classList.toggle('is-visible', past);
        sticky.setAttribute('aria-hidden', past ? 'false' : 'true');
      }).observe(buy);
    }
  })();
</script>

